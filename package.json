{
  "name": "geohash-minify",
  "version": "0.1.2",
  "description": "Compress a list of geohashes using the best combination across various precisions",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    "require": "./dist/index.js",
    "import": "./dist/index.mjs"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "author": "Alberto Rico",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alrico88/geohash-minify"
  },
  "sideEffects": false,
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@rslib/core": "^0.23.2",
    "@vitest/coverage-v8": "^1.6.1",
    "coveralls": "^3.1.1",
    "husky": "^8.0.3",
    "typedoc": "^0.25.4",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "geohash",
    "compress",
    "minify"
  ],
  "scripts": {
    "dev": "rslib --watch",
    "build": "rslib",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "biome check --write src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts --readme README.md --gitRevision master --plugin typedoc-plugin-markdown",
    "prepack": "pnpm run build",
    "coveralls": "vitest run --coverage && cat ./coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run lint"
    }
  }
}
